# Supabase > Project Settings > Database > Connect > Session pooler (or direct connection)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Your own verified Supabase login email. Only verified matching email gets initial admin role.
ADMIN_EMAILS=your-email@example.com
# Separate multiple frontend origins with commas. No wildcard in production.
APP_ORIGINS=http://localhost:5173,https://your-partner-hub.vercel.app
PUBLIC_API_ORIGIN=http://localhost:4000
PORT=4000
NODE_ENV=development
# Required for production admin integrations / reconciliation. 32+ random characters.
CRON_SECRET=replace_with_random_long_secret

# PAYMENT ENGINE V2 (safe by default: do not use live keys until tests pass)
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_TEST_SECRET
PAYMENTS_LIVE_ENABLED=false
# Comma-separated exact origins of connected product sites; add the actual product URL origin.
PRODUCT_ORIGINS=https://kingdom.example,https://xray.example
# DATABASE_CA_CERT may be required for the Supabase session pooler certificate chain.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
